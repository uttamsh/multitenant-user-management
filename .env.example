# Copy to .env and replace the placeholder password with your local database password.
# Loaded automatically from the working directory; existing environment variables take precedence.
HTTP_ADDR=127.0.0.1:8080
# Swagger is enabled by default only for APP_ENV=development.
APP_ENV=development
# Optional override: SWAGGER_ENABLED=false (or explicit true outside development).
DATABASE_URL=postgres://app:REPLACE_ME@127.0.0.1:5432/multitenant?sslmode=disable
# Compose API only: use the SAME existing database credentials; service DNS is postgres.
DOCKER_DATABASE_URL=postgres://app:REPLACE_ME@postgres:5432/multitenant?sslmode=disable
# API_PORT=8080
# API_STOP_GRACE_PERIOD=30s (keep longer than SHUTDOWN_TIMEOUT)
# sslmode=disable is for local development. Configure TLS for remote databases.
DB_MAX_CONNS=10
DB_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s
# Required: generate a secret with `openssl rand -hex 32`; keep the real value in .env only.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
JWT_ISSUER=multitenant-user-management
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
